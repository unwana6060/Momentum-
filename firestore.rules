rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'unwanaotung@gmail.com'
      );
    }

    function isVerified() {
      return isSignedIn();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt'])
        && data.email is string
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidHabit(data) {
       return data.keys().hasAll(['userId', 'title', 'scheduleType', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidCompletion(data) {
       return data.keys().hasAll(['userId', 'habitId', 'date', 'completedAt', 'status'])
        && data.userId == request.auth.uid
        && data.date is string && data.date.size() == 10
        && data.completedAt == request.time;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && incoming().updatedAt == request.time && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'theme', 'updatedAt']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['xp', 'level', 'longestStreak', 'updatedAt'])
      ) || isAdmin();
    }

    // 2. Habits
    match /habits/{habitId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isOwner(existing().userId) || isAdmin();
      allow create: if isValidId(habitId) && isVerified() && isValidHabit(incoming());
      allow update: if (isOwner(existing().userId) && incoming().updatedAt == request.time && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'color', 'icon', 'scheduleType', 'scheduleDays', 'updatedAt']) ||
        (incoming().userId == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['currentStreak', 'longestStreak', 'totalCompletions', 'updatedAt']))
      )) || isAdmin();
      allow delete: if isOwner(existing().userId) || isAdmin();

      // 3. Completions (Nested or Top-level)
      match /completions/{completionId} {
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow get: if isOwner(resource.data.userId) || isAdmin();
        allow create: if isVerified() && incoming().userId == request.auth.uid 
          && isValidCompletion(incoming()) && incoming().habitId == habitId;
        allow update: if isOwner(existing().userId) && (
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt'])
        ) || isAdmin();
        allow delete: if isOwner(existing().userId) || isAdmin();
      }
    }

    // 4. System
    match /system/{docId} {
      allow get: if isSignedIn();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'unwanaotung@gmail.com'
      );
    }

    function isVerified() {
      return isSignedIn();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt'])
        && data.email is string;
    }

    function isValidHabit(data) {
       return data.keys().hasAll(['userId', 'title', 'scheduleType', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0;
    }

    function isValidCompletion(data) {
       return data.keys().hasAll(['userId', 'habitId', 'date', 'completedAt', 'status'])
        && data.userId == request.auth.uid
        && data.date is string && data.date.size() == 10;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) || isAdmin();
    }

    // 2. Habits
    match /habits/{habitId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidHabit(incoming());
      allow update: if isOwner(existing().userId) || isAdmin();
      allow delete: if isOwner(existing().userId) || isAdmin();

      // 3. Completions (Nested)
      match /completions/{completionId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/habits/$(habitId)).data.userId == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && (get(/databases/$(database)/documents/habits/$(habitId)).data.userId == request.auth.uid || isAdmin());
        allow update: if isSignedIn() && (get(/databases/$(database)/documents/habits/$(habitId)).data.userId == request.auth.uid || isAdmin());
        allow delete: if isSignedIn() && (get(/databases/$(database)/documents/habits/$(habitId)).data.userId == request.auth.uid || isAdmin());
      }
    }

    // 4. System
    match /system/{docId} {
      allow get: if isSignedIn();
    }
  }
}

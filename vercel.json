{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/((?!assets/|logo.svg|ads.txt|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
